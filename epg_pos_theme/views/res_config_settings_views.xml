<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- POS Settings overrides -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.epg_pos_theme</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Hide the Preparation Display section -->
            <xpath expr="//setting[@id='preparation_display']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Override settings sidebar app icon for POS -->
            <xpath expr="//app[@name='point_of_sale']" position="attributes">
                <attribute name="logo">/epg_pos_theme/static/description/pos.svg</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inventory Settings overrides -->
    <record id="res_config_settings_view_form_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock.epg_pos_theme</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Override settings sidebar app icon for Inventory -->
            <xpath expr="//app[@name='stock']" position="attributes">
                <attribute name="logo">/epg_pos_theme/static/description/inventario.svg</attribute>
            </xpath>
        </field>
    </record>
</odoo>
