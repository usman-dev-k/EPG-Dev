    <record id="res_config_settings_hide_url_block" model="ir.ui.view">
        <field name="name">res.config.settings.hide.url.block</field>
        <field name="model">res.config.settings</field>
        <!-- ✅ Inherit from the view that ADDED the block, not from base -->
        <field name="inherit_id" ref="odoo_url_replacer.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='url_replacement_setting_block']" position="replace">
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_hide_yapily_block" model="ir.ui.view">
        <field name="name">res.config.settings.hide.yapily.block</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account_bank_sync_yapily.res_config_settings_view_form_yapily"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='yapily_settings']" position="replace">
            </xpath>
        </field>
    </record>

